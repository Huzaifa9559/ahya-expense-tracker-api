# Copy to .env and adjust. Never commit .env.

APP_NAME=ahya-expense-tracker-api

# App DB (docker-compose postgres service)
DATABASE_URL=postgresql+asyncpg://ahya:ahya@localhost:5432/expense_tracker

# Pytest uses this DB (created by scripts/init-databases.sql or scripts/create_test_db.sh)
TEST_DATABASE_URL=postgresql+asyncpg://ahya:ahya@localhost:5432/expense_tracker_test

# Redis DB 0 for app; tests use DB 15 so FLUSHDB cannot wipe app keys
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

JWT_SECRET=dev-only-not-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# LocalStack S3 (compose service `s3`, host maps 9000 -> container 4566)
S3_ENDPOINT_URL=http://localhost:9000
# Presign only — browser/host reachable URL (differs inside vs outside Docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=ahya-receipts
S3_REGION=us-east-1

CORS_ORIGINS=["*"]
